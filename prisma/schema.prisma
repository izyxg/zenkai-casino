generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  COINFLIP
  BLACKJACK
  POKER
}

enum RoomStatus {
  LOBBY
  ACTIVE
  CLOSED
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

model Room {
  id              String      @id @default(cuid())
  code            String      @unique
  gameType        GameType
  status          RoomStatus  @default(LOBBY)
  minBet          Int
  maxBet          Int
  maxPlayers      Int
  startingBalance Int
  locked          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  players         Player[]
  games           Game[]
  transactions    Transaction[]
  events          GameEvent[]
}

model Player {
  id           String        @id @default(cuid())
  roomId       String
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name         String
  sessionHash  String
  balance      Int
  currentBet   Int           @default(0)
  isHost       Boolean       @default(false)
  joinedAt     DateTime      @default(now())
  lastSeen     DateTime      @default(now())
  transactions Transaction[]

  @@unique([roomId, name])
  @@index([roomId])
}

model Game {
  id        String      @id @default(cuid())
  roomId    String
  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      GameType
  status    GameStatus  @default(WAITING)
  state     Json
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  @@index([roomId, startedAt])
}

model Transaction {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount       Int
  balanceAfter Int
  type         String
  reason       String
  createdAt    DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([playerId, createdAt])
}

model GameEvent {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  gameId    String?
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}
